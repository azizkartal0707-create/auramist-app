/* Görsel Tarot Kartları Tasarımı */
.tarot-grid { 
  display: grid; 
  grid-template-columns: repeat(3, 1fr); 
  gap: 12px; 
  margin-top: 10px; 
}

.tarot-card { 
  aspect-ratio: 2/3.5; 
  border-radius: 10px; 
  border: 2px solid #5a264a; 
  cursor: pointer; 
  transition: all 0.3s ease; 
  position: relative;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.5);
}

.tarot-card.selected { 
  transform: translateY(-8px) scale(1.03); 
  border-color: #ffd700; 
  box-shadow: 0 0 18px rgba(255, 215, 0, 0.8); 
}

.tarot-card.flipped {
  transform: rotateY(180deg);
}

/* Yüklenen Fotoğraf Önizlemeleri */
.preview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
.preview-img { width: 100%; height: 120px; object-fit: cover; border-radius: 10px; border: 1px solid var(--accent-pink); }
