// ☕ Kahve Falı İçin Yapay Zeka Analizi
async function startCoffeeReading() {
  if (stars < 10) return alert('Yetersiz Yıldız! Lütfen cüzdanınızdan yıldız yükleyin.');
  if (uploadedImages.length === 0) return alert('Lütfen en az bir fincan fotoğrafı yükleyin!');
  
  stars -= 10;
  document.getElementById('star-count').innerText = stars;

  const btn = document.getElementById('analyze-btn');
  btn.innerText = 'Yapay Zeka Telve Desenlerini Çözümlüyor... ✨';
  btn.disabled = true;

  try {
    // Gerçek bir AI backend endpoint'ine bağlanıyorsanız burayı kullanabilirsiniz:
    /*
    const response = await fetch('https://sizin-backend-adresiniz.com/api/coffee-reading', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ images: uploadedImages })
    });
    const data = await response.json();
    let aiComment = data.comment;
    */

    // Simüle edilmiş dinamik yapay zeka yanıt üretici (Backend bağlanana kadar aktif kalır)
    setTimeout(() => {
      const aiComments = [
        "Fincanınızın dip kısmında birleşen iki yol ve etrafında uçuşan kuş figürleri, yakın zamanda alacağınız sevindirici bir habere işaret ediyor. Maddi konularda ani bir rahatlama ve kafanızı kurcalayan bir kararın lehinize sonuçlanacağını görüyorum.",
        "Tevlenizde büyük bir dağ ve dağın eteklerinden akıp gelen berrak bir su var. Sabrınızın karşılığını alacağınız, özellikle kariyer ve kazanç alanında uzun süredir beklediğiniz kapıların nihayet aralanacağı bir döneme giriyorsunuz.",
        "Kahve falınızda bir yüzük ve parlayan bir yıldız sembolü belirmiş. Kalbinizi açtığınız yeni bir ilişki veya ortaklık gündeme gelebilir. Enerjiniz oldukça yüksek, sezgilerinize bu süreçte güvenin."
      ];
      const randomComment = aiComments[Math.floor(Math.random() * aiComments.length)];

      btn.style.display = 'none';
      document.getElementById('coffee-result').style.display = 'block';
      document.getElementById('coffee-text').innerText = randomComment;
    }, 2500);

  } catch (error) {
    alert('Yapay zeka analiz sırasında bir hata oluştu. Lütfen tekrar deneyin.');
    btn.disabled = false;
    btn.innerText = 'Yapay Zeka Analizini Başlat (10 ★)';
  }
}

// 🔮 Tarot Falı İçin Yapay Zeka Analizi
async function startTarotReading() {
  if (stars < 15) return alert('Yetersiz Yıldız! Lütfen cüzdanınızdan yıldız yükleyin.');
  
  stars -= 15;
  document.getElementById('star-count').innerText = stars;

  const btn = document.getElementById('tarot-read-btn');
  btn.innerText = 'Karakter Enerjileri Yapay Zeka ile Harmanlanıyor... ✨';
  btn.disabled = true;

  // Seçilen kartları görsel olarak çevir
  const cards = document.querySelectorAll('.tarot-card.selected');
  cards.forEach((card, index) => {
    setTimeout(() => {
      card.style.backgroundImage = `url('${tarotFrontImages[index % tarotFrontImages.length].img}')`;
    }, index * 350);
  });

  setTimeout(() => {
    btn.style.display = 'none';
    document.getElementById('tarot-result').style.display = 'block';
    
    // Yapay zeka sentezli 3 kart yorumu
    document.getElementById('tarot-text').innerHTML = `
      <strong>1. Kart (Geçmiş / Kökler): ${tarotFrontImages[0].name}</strong><br>${tarotFrontImages[0].desc}<br><br>
      <strong>2. Kart (Şimdi / Enerji): ${tarotFrontImages[1].name}</strong><br>${tarotFrontImages[1].desc}<br><br>
      <strong>3. Kart (Gelecek / Sonuç): ${tarotFrontImages[2].name}</strong><br>${tarotFrontImages[2].desc}<br><br>
      <em>✨ Yapay Zeka Sentezi: Seçtiğiniz kartların ortak enerjisi, geçmişteki yorgunlukları geride bırakıp büyük bir aydınlanma ve bolluk dönemine adım attığınızı fısıldıyor.</em>
    `;
  }, 2200);
}
